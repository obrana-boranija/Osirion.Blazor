{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Feeds": {
    "SiteUrl": "https://example.com",
    "Title": "My Product news",
    "Description": "Announcements and updates from My Product.",
    "FeedDirectory": "news",
    "AdditionalSitemapUrls": [ "/", "/news" ]
  },
  "Osirion": {
    "Theming": {
      "Framework": "None",
      "DefaultMode": "System",
      "DefaultPalette": "Osirion"
    },
    "Site": {
      "Name": "My Product",
      "HomeUrl": "/",
      "Menu": [
        { "Text": "News", "Href": "/news", "MatchPrefix": true },
        { "Text": "About", "Href": "/about" },
        { "Text": "Contact", "Href": "/contact" }
      ],
      "ShowThemeToggle": true,
      "FooterDescription": "Say in one sentence what My Product does and who it is for.",
      "FooterSections": [
        {
          "Title": "Company",
          "Links": [
            { "Text": "About", "Href": "/about" },
            { "Text": "Contact", "Href": "/contact" }
          ]
        },
        {
          "Title": "News",
          "Links": [
            { "Text": "All news", "Href": "/news" },
            { "Text": "RSS feed", "Href": "/feed.xml" }
          ]
        }
      ],
      "SocialTitle": "Follow",
      "SocialLinks": [
        { "Network": "rss", "Href": "/feed.xml", "Label": "My Product news RSS feed" }
      ]
    },
    "Cms": {
      "Web": {
        "FileSystem": {
          "BasePath": "content",
          "IsDefault": true,
          "WatchForChanges": true
        }
      }
    },
    "Seo": {
      "SiteName": "My Product",
      "SiteUrl": "https://example.com",
      "SiteDescription": "Say in one sentence what My Product does and who it is for."
    }
  }
}
