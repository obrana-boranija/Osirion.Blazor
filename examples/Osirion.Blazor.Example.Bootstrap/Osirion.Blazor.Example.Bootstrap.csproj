<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="compilerconfig.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="compilerconfig.json" />
  </ItemGroup>

  <!-- Content demos show their own Razor source in a Code tab -->
  <ItemGroup>
    <EmbeddedResource Include="Components\Demos\*.razor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Osirion.Blazor\Osirion.Blazor.csproj" />
    <ProjectReference Include="..\Osirion.Blazor.Examples.Shared\Osirion.Blazor.Examples.Shared.csproj" />
  </ItemGroup>

  <!-- Integrate CSS tree-shaking MSBuild target -->
  <Import Project="..\..\..\build\Osirion.Blazor.targets" Condition="Exists('..\..\..\build\Osirion.Blazor.targets')" />

</Project>
