@page "/docs/{*slug}"
@page "/{locale}/docs/{*slug}"
@* @page "/docs/{slug}"
@page "/{locale}/docs/{slug}"
@page "/docs/components/{slug}"
@page "/{locale}/docs/components/{slug}" *@
@using Osirion.Blazor.Cms.Web.Components


@* <ArticlePage Locale="@(Locale ?? "en")" DirectoryName="docs" ItemSlug="@(Slug ?? "getting-started")" /> *@

@if (string.IsNullOrWhiteSpace(Slug))
{
    <ContentList Locale="@Locale" Category="Components" ShowPagination ItemsPerPage="24"
                 PageTitle="Documentation" PageDescription="Component and module documentation for Osirion.Blazor." />
}
else
{
    <ArticlePage ItemUrl="@($"/docs/{Slug}")"
                 Locale="@Locale"
                 SchemaTypes="@(new[] { SchemaType.Article, SchemaType.BreadcrumbList })" />
}

@code {
    [Parameter]
    public string? Locale { get; set; } = "en";

    [Parameter]
    public string? Slug { get; set; }
}