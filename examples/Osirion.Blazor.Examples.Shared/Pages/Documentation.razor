@page "/docs/{*slug}"
@using Osirion.Blazor.Examples.Shared.Docs

@* /docs, the guides and the package pages, from content/en/docs. Addresses carry no locale: the site is in English,
   and content URLs leave the locale folder out. *@
<DocsArticle Url="@("/docs/" + Slug)" />

@code {
    /// <summary>The path after /docs, such as <c>getting-started</c> or <c>packages/core</c>.</summary>
    [Parameter]
    public string? Slug { get; set; }
}
