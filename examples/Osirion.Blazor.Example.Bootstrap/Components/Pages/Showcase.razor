@page "/showcase"
@using Osirion.Blazor.Cms.Web.Components

@* Sites built with Osirion.Blazor. The heading and introduction come from content/en/showcase.md. Every component that
   this page used to render has its own page with a live demo under /components. *@
<AboutPage ItemSlug="showcase" SchemaTypes="[SchemaType.CollectionPage]">
    <ul class="showcase-sites">
        @foreach (var site in Sites)
        {
            <li class="showcase-site">
                <a href="@site.Url" class="showcase-site-image">
                    <img src="@site.Image" width="1280" height="800" loading="lazy" alt="@site.ImageAlt" />
                </a>
                <div class="showcase-site-text">
                    <h2><a href="@site.Url">@site.Name</a></h2>
                    @foreach (var paragraph in site.Description)
                    {
                        <p>@paragraph</p>
                    }
                    <p class="showcase-site-features"><strong>Osirion features you can see:</strong> @site.Features</p>
                </div>
            </li>
        }
    </ul>
</AboutPage>
