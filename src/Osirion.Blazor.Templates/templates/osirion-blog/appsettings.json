{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Feeds": {
    "SiteUrl": "https://example.com",
    "Title": "My Blog",
    "Description": "Notes, guides and ideas, written in Markdown.",
    "FeedDirectory": "blog",
    "AdditionalSitemapUrls": [ "/", "/blog" ]
  },
  "Osirion": {
    "Theming": {
      "Framework": "None",
      "DefaultMode": "System",
      "DefaultPalette": "Osirion"
    },
    "Site": {
      "Name": "My Blog",
      "HomeUrl": "/",
      "Menu": [
        { "Text": "Blog", "Href": "/blog", "MatchPrefix": true },
        { "Text": "About", "Href": "/about" }
      ],
      "ShowThemeToggle": true,
      "FooterDescription": "Notes, guides and ideas, written in Markdown.",
      "FooterSections": [
        {
          "Title": "Read",
          "Links": [
            { "Text": "Blog", "Href": "/blog" },
            { "Text": "About", "Href": "/about" },
            { "Text": "RSS feed", "Href": "/feed.xml" }
          ]
        }
      ],
      "SocialTitle": "Follow",
      "SocialLinks": [
        { "Network": "rss", "Href": "/feed.xml", "Label": "My Blog RSS feed" }
      ]
    },
    "Cms": {
      "Web": {
        "FileSystem": {
          "BasePath": "content",
          "IsDefault": true,
          "WatchForChanges": true
        }
      }
    },
    "Seo": {
      "SiteName": "My Blog",
      "SiteUrl": "https://example.com",
      "SiteDescription": "Notes, guides and ideas, written in Markdown."
    }
  }
}
