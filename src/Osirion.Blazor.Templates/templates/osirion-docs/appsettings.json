{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Feeds": {
    "SiteUrl": "https://example.com",
    "Title": "My Docs",
    "Description": "Documentation written in Markdown.",
    "EnableRss": false,
    "EnableAtom": false,
    "AdditionalSitemapUrls": [ "/" ]
  },
  "Osirion": {
    "Theming": {
      "Framework": "None",
      "DefaultMode": "System",
      "DefaultPalette": "Osirion"
    },
    "Site": {
      "Name": "My Docs",
      "HomeUrl": "/",
      "Menu": [
        { "Text": "Documentation", "Href": "/docs/introduction", "MatchPrefix": true }
      ],
      "ShowThemeToggle": true,
      "FooterDescription": "Documentation written in Markdown.",
      "FooterSections": [
        {
          "Title": "Documentation",
          "Links": [
            { "Text": "Introduction", "Href": "/docs/introduction" },
            { "Text": "Writing pages", "Href": "/docs/writing-pages" },
            { "Text": "Configuration", "Href": "/docs/configuration" }
          ]
        }
      ]
    },
    "Cms": {
      "Web": {
        "FileSystem": {
          "BasePath": "content",
          "IsDefault": true,
          "WatchForChanges": true
        }
      }
    },
    "Seo": {
      "SiteName": "My Docs",
      "SiteUrl": "https://example.com",
      "SiteDescription": "Documentation written in Markdown."
    }
  }
}
