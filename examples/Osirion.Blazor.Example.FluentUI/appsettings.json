{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Osirion": {
    "Theming": {
      "UseDefaultStyles": false,
      "Framework": "FluentUI",
      "DefaultMode": "Light",
      "EnableDarkMode": true,
      "FollowSystemPreference": true
    },
    "Cms": {
      "Web": {
        "FileSystem": {
          "BasePath": "../../content",
          "ProviderId": "local-content",
          "IsDefault": true,
          "WatchForChanges": false,
          "EnableLocalization": true,
          "DefaultLocale": "en",
          "SupportedLocales": [ "en", "sr", "sr-Latn-RS" ],
          "SupportedExtensions": [ ".md", ".markdown" ]
        }
      }
    },
    "Seo": {
      "SiteName": "Osirion Blazor with Fluent UI",
      "SiteDescription": "Osirion.Blazor content components styled by the Fluent UI adapter",
      "OrganizationName": "Osirion",
      "SiteLogoUrl": "/favicon.png",
      "AllowSearchIndexing": false,
      "DefaultImageUrl": "/assets/images/blazor-cover.png",
      "DefaultImageWidth": 1200,
      "DefaultImageHeight": 630,
      "BreadcrumbHomeText": "Home"
    }
  }
}
