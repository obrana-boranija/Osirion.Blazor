@page "/not-found"

<PageTitle>Page not found</PageTitle>

<div class="px-4 py-6">
    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center">
        <FluentText As="TextTag.H1" Size="TextSize.Size800" Weight="TextWeight.Semibold">Page not found</FluentText>
        <FluentText As="TextTag.Paragraph" Size="TextSize.Size400">The page you are looking for does not exist or has moved.</FluentText>
        <FluentAnchorButton Href="/" Appearance="ButtonAppearance.Primary">Back to the home page</FluentAnchorButton>
    </FluentStack>
</div>
