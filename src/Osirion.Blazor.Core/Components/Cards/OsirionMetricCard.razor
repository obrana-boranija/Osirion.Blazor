@namespace Osirion.Blazor.Components
@inherits OsirionComponentBase
@using BlazorJSComponents
@attribute [DiscoverCollocatedJS]
@inject JSElementReferenceScope Refs

<article class="osirion-metric-card osirion-metric-card-@Accent.ToString().ToLowerInvariant() osirion-metric-card-border-@Border.ToString().ToLowerInvariant() osirion-metric-card-shadow-@EffectiveShadow.ToString().ToLowerInvariant() @CssClass"
         data-ref="@Refs["root"]"
         @attributes="Attributes">
    @if (!string.IsNullOrWhiteSpace(Kicker))
    {
        <span class="osirion-metric-card-kicker">@Kicker</span>
    }
    <div class="osirion-metric-card-value" data-ref="@Refs["value"]" data-osirion-metric="@(Animate ? "true" : "false")" data-count="@NumericValue" data-prefix="@Prefix" data-suffix="@Suffix">@Value</div>
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <div class="osirion-metric-card-label">@Label</div>
    }
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <div class="osirion-metric-card-description">@Description</div>
    }
</article>

<JS Src="./_content/Osirion.Blazor.Core/Components/Cards/OsirionMetricCard.razor.js" Args="[Refs, Animate]" />