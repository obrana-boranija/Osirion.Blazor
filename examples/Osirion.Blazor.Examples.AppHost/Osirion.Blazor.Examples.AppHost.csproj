<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>f31d4a61-ecbf-4f4e-b805-96187fec3e29</UserSecretsId>
    <!-- DCP and the dashboard come from the NuGet packages this SDK version pins, so dotnet run, the IDE and CI do not
         depend on which Aspire CLI is installed. ASPIRE010 only reports that the CLI bundle is not used. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Osirion.Blazor.Example.Bootstrap\Osirion.Blazor.Example.Bootstrap.csproj" />
    <ProjectReference Include="..\Osirion.Blazor.Example.FluentUI\Osirion.Blazor.Example.FluentUI.csproj" />
    <ProjectReference Include="..\Osirion.Blazor.Example.Mud\Osirion.Blazor.Example.Mud.csproj" />
  </ItemGroup>

</Project>
