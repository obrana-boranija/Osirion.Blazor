@using Osirion.Blazor.Components

<OsirionCallout Type="CalloutType.Note">
    <p>Callouts need no script and follow the site's theme.</p>
</OsirionCallout>

<OsirionCallout Type="CalloutType.Tip" Title="Set a title">
    <p>Without <code>Title</code>, the callout shows the name of its type.</p>
</OsirionCallout>

<OsirionCallout Type="CalloutType.Warning" Title="Back up first">
    <p>Back up the database before you run the migration.</p>
</OsirionCallout>
