@namespace Osirion.Blazor.Components
@inherits OsirionComponentBase
@using BlazorJSComponents
@attribute [DiscoverCollocatedJS]
@inject JSElementReferenceScope Refs

<div class="@GetPageLayoutClass()" data-ref="@Refs["root"]" @attributes="Attributes">
    @if (ShowSkipLink)
    {
        <a class="osirion-skip-link" href="@SkipLinkHref" data-ref="@Refs["skip"]">@SkipLinkText</a>
    }

    @if (Header is not null)
    {
        <header class="osirion-page-header @(EnableHeaderScrollBehavior ? "osirion-page-header-scroll" : null)" data-ref="@Refs["header"]">
            @Header
        </header>
    }

    @* tabindex="-1" lets the skip link move keyboard focus here, not only scroll *@
    <main id="@MainContentId" class="osirion-page-main" tabindex="-1" data-ref="@Refs["main"]">
        @Body
    </main>

    @if (Footer is not null)
    {
        <footer class="osirion-page-footer">
            @Footer
        </footer>
    }
</div>

<JS Src="./_content/Osirion.Blazor.Core/Components/Layout/OsirionPageLayout.razor.js" Args="[Refs, EnableHeaderScrollBehavior]" />
