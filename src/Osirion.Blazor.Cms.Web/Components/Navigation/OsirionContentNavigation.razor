@namespace Osirion.Blazor.Cms.Web.Components

@if (ShowNavigation && (ShownPreviousItem is not null || ShownNextItem is not null) && Item is not null)
{
    <nav class="@GetNavigationClass()" aria-label="@AriaLabel" @attributes="Attributes">
        @if (ShownPreviousItem is not null)
        {
            <a href="@GetNavigationUrl(ShownPreviousItem)" class="osirion-content-previous" @onclick:preventDefault="@PreventDefault">
                <span class="osirion-content-navigation-label">
                    @if (ShowIcons && PreviousIcon is not null)
                    {
                        <span class="osirion-content-navigation-icon">
                            @PreviousIcon
                        </span>
                    }
                    @PreviousLabel
                </span>
                <span class="osirion-content-navigation-title">@GetItemTitle(ShownPreviousItem)</span>
                @if (!string.IsNullOrWhiteSpace(GetItemDescription(ShownPreviousItem)) && ShowDescription)
                {
                    <span class="osirion-content-navigation-description">@GetItemDescription(ShownPreviousItem)</span>
                }
            </a>
        }
        else if (ShowPlaceholder)
        {
            <div class="osirion-content-navigation-placeholder"></div>
        }

        @if (ShownNextItem is not null)
        {
            <a href="@GetNavigationUrl(ShownNextItem)" class="osirion-content-next" @onclick:preventDefault="@PreventDefault">
                <span class="osirion-content-navigation-label">
                    @NextLabel
                    @if (ShowIcons && NextIcon is not null)
                    {
                        <span class="osirion-content-navigation-icon">
                            @NextIcon
                        </span>
                    }
                </span>
                <span class="osirion-content-navigation-title">@GetItemTitle(ShownNextItem)</span>
                @if (!string.IsNullOrWhiteSpace(GetItemDescription(ShownNextItem)) && ShowDescription)
                {
                    <span class="osirion-content-navigation-description">@GetItemDescription(ShownNextItem)</span>
                }
            </a>
        }
        else if (ShowPlaceholder)
        {
            <div class="osirion-content-navigation-placeholder"></div>
        }
    </nav>
}