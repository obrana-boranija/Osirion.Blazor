@page "/not-found"

<PageTitle>Page not found</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-12 text-center">
    <MudText Typo="Typo.h3" HtmlTag="h1" GutterBottom>Page not found</MudText>
    <MudText Typo="Typo.subtitle1" Class="mb-6">The page you are looking for does not exist or has moved.</MudText>
    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">Back to the home page</MudButton>
</MudContainer>
