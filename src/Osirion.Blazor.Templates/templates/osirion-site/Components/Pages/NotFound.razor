@page "/not-found"

@* Shown with status 404 for an address no page claims, a news item that does not exist and a missing file. *@
<NotFoundPage Suggestions="suggestions" />

@code {
    private static readonly IReadOnlyList<ContentNotFoundSuggestion> suggestions =
    [
        new() { Text = "News", Url = "/news", Description = "Announcements and updates, newest first." },
        new() { Text = "About", Url = "/about", Description = "Who we are." },
        new() { Text = "Contact", Url = "/contact", Description = "How to reach us." },
    ];
}
