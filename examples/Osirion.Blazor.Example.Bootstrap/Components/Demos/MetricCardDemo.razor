@using Osirion.Blazor.Components

@* Sample figures for a shop, not facts about anything *@
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 1rem;">
    <OsirionMetricCard Kicker="Sample" Value="1250" Label="Orders this month" Animate="true" />
    <OsirionMetricCard Kicker="Sample" Value="2-4 days" Label="Delivery time" Accent="MetricCardAccent.Blue" Animate="true" />
    <OsirionMetricCard Kicker="Sample" Value="98%" Label="Delivered on time" Accent="MetricCardAccent.Purple" Border="MetricCardBorder.Default" />
</div>
