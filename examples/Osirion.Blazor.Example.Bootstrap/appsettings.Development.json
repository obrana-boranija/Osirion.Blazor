{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Osirion": {
    "Analytics": {
      "Matomo": { "Enabled": false },
      "Clarity": { "Enabled": false },
      "GA4": { "Enabled": false }
    },
    "Cms": {
      "Web": {
        "GitHub": {
          "Blog": {
            "IsDefault": false,
            "EnablePolling": false
          }
        },
        "FileSystem": {
          "BasePath": "../../content",
          "ProviderId": "local-content",
          "IsDefault": true,
          "WatchForChanges": true,
          "EnableLocalization": true,
          "DefaultLocale": "en",
          "SupportedLocales": [ "en", "sr", "sr-Latn-RS" ],
          "SupportedExtensions": [ ".md", ".markdown" ]
        }
      }
    }
  }
}
