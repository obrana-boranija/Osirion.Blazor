@using Osirion.Blazor.Components
@using Osirion.Blazor.Navigation.Components
@using Osirion.Blazor.Theming.Components
@inherits LayoutComponentBase

<OsirionPageLayout StickyFooter EnableHeaderScrollBehavior>
    <Header>
        <OsirionAnnouncementBar Id="components-4-1">
            New in 4.0: tabs, FAQ, feeds, video embeds and more. <a href="showcase">See the showcase</a>
        </OsirionAnnouncementBar>
        <NavMenu />
    </Header>

    <Body>
        @Body
    </Body>

    <Footer>
        <Footer />
    </Footer>
</OsirionPageLayout>

<OsirionStyles />
<OsirionCookieConsent />
<ScrollToTopProvider />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
