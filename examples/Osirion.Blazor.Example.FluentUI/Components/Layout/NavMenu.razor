@using Osirion.Blazor.Cms.Web.Components
@using Osirion.Blazor.Navigation.Components
@using Osirion.Blazor.Theming.Components

<Menu AriaLabel="Main navigation"
      Orientation="MenuOrientation.Horizontal"
      Alignment="MenuAlignment.Right"
      CollapseOnMobile
      CollapseBreakpoint="MenuCollapseBreakpoint.Large"
      BrandLogo="/favicon.png"
      BrandText="Osirion.Blazor"
      Sticky>
    <ChildContent>
        <MenuItem Text="Components" HasSubmenu SubmenuVariant="SubmenuVariant.Mega">
            <ChildContent>
                <MenuGroup Label="Content and CMS"
                           Description="Render Markdown from GitHub or local files.">
                    <MenuItem Text="Content list" Description="Paged, filterable lists of posts and pages." Href="/docs/components/cms-web/core/content-list" />
                    <MenuItem Text="Content page" Description="An article with metadata, breadcrumbs and SEO." Href="/docs/components/cms-web/core/content-page" />
                    <MenuItem Text="Table of contents" Description="Built from the headings of the page." Href="/docs/components/cms-web/navigation/table-of-contents" />
                </MenuGroup>
                <MenuGroup Label="Sections and cards"
                           Description="Compose landing pages from ready-made blocks.">
                    <MenuItem Text="Hero section" Description="Headline, actions and an image, in four layouts." Href="/docs/components/core/sections/hero-section" />
                    <MenuItem Text="Feature card" Description="Icon, title and text for a feature grid." Href="/docs/components/core/cards/feature-card" />
                    <MenuItem Text="Testimonial carousel" Description="Quotes that scroll without JavaScript." Href="/docs/components/core/carousels/testimonial-carousel" />
                </MenuGroup>
                <MenuGroup Label="Navigation and theming"
                           Description="Menus, breadcrumbs and light or dark themes.">
                    <MenuItem Text="Breadcrumbs" Description="Where the reader is, with structured data." Href="/docs/components/core/navigation/breadcrumbs" />
                    <MenuItem Text="Theme toggle" Description="Light, dark or the system preference." Href="/docs/components/theming/theme-toggle" />
                    <MenuItem Text="Cookie consent" Description="Ask before any tracker loads." Href="/docs/components/core/popups/cookie-consent" />
                </MenuGroup>
                <MenuCallToAction Text="Browse all components"
                                  Description="Guides and parameter reference for every module."
                                  Href="/docs" />
            </ChildContent>
            <SubmenuAside>
                <MenuImageCard ImageUrl="https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=640&q=70&auto=format&fit=crop"
                               ImageAlt="A laptop showing code on a bright desk"
                               Title="Build a docs site in an afternoon"
                               Description="Markdown in, a fast server-rendered site out."
                               Href="/docs" />
            </SubmenuAside>
        </MenuItem>

        <MenuItem Text="Guides" HasSubmenu>
            <MenuItem Text="Build a blog with GitHub" Href="/blog/github-cms-with-blazor" />
            <MenuItem Text="Content and SEO" HasSubmenu>
                <MenuItem Text="SEO checklist for SSR" Href="/blog/blazor-seo-ssr-ssg-checklist" />
                <MenuItem Text="Localization" Href="/blog/localization-for-blazor-content-sites" />
                <MenuItem Text="Structuring content" Href="/blog/structuring-content-repositories" />
            </MenuItem>
            <MenuItem Text="Pages and navigation" HasSubmenu>
                <MenuItem Text="Hero sections" Href="/blog/modern-hero-sections-blazor" />
                <MenuItem Text="Navigation components" Href="/blog/navigation-components" />
                <MenuItem Text="Scroll after navigation" Href="/blog/enhanced-navigation-interceptor" />
            </MenuItem>
            <MenuItem Text="Privacy and analytics" HasSubmenu>
                <MenuItem Text="Cookie consent and GDPR" Href="/blog/gdpr-cookie-consent-blazor" />
                <MenuItem Text="Analytics integration" Href="/blog/analytics-integration-in-blazor" />
            </MenuItem>
            <MenuItem Text="Performance tuning" Href="/blog/performance-tuning-content-heavy-blazor-sites" />
            <MenuDivider />
            <MenuItem Text="All articles" Href="/blog" />
        </MenuItem>

