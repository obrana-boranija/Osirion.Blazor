@namespace Osirion.Blazor.Components
@inherits OsirionComponentBase
@using BlazorJSComponents
@inject JSElementReferenceScope Refs

<section class="@GetCarouselClass()" 
         aria-label="@SectionTitle"
         style="@Style"
         data-ref="@Refs["root"]"
         @attributes="Attributes">
    
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="osirion-carousel-header">
            <h2 class="osirion-carousel-title">@Title</h2>
        </div>
    }
    
    <div class="osirion-carousel-container" style="@GetCarouselListStyle()">
        <div class="osirion-carousel-wrapper"
             tabindex="0"
               data-ref="@Refs["viewport"]"
             data-autoscroll="@(EnableAutoScroll ? "true" : "false")"
             data-autoscroll-direction="@Direction.ToString().ToLowerInvariant()">
        <div class="osirion-carousel-track" data-ref="@Refs["track"]">
            <ul class="osirion-carousel-list" role="list">
                @foreach (var logo in VisibleLogos)
                {
                    <li class="@GetLogoClass(logo)" role="listitem">
                        @if (!string.IsNullOrWhiteSpace(logo.Url))
                        {
                            <a @attributes="GetLogoLinkAttributes(logo)">
                                @if (logo.HasDualLogos)
                                {
                                    <img src="@logo.LightImageUrl" 
                                         width="@LogoWidth" 
                                         height="@LogoHeight" 
                                         alt="@logo.AltText" 
                                         loading="lazy"
                                         draggable="false"
                                         class="osirion-logo-light">
                                    <img src="@logo.DarkImageUrl" 
                                         width="@LogoWidth" 
                                         height="@LogoHeight" 
                                         alt="@logo.AltText" 
                                         loading="lazy"
                                         draggable="false"
                                         class="osirion-logo-dark">
                                }
                                else
                                {
                                    <img src="@GetLogoUrl(logo)" 
                                         width="@LogoWidth" 
                                         height="@LogoHeight" 
                                         alt="@logo.AltText" 
                                         loading="lazy"
                                         draggable="false">
                                }
                            </a>
                        }
                        else
                        {
                            @if (logo.HasDualLogos)
                            {
                                <img src="@logo.LightImageUrl" 
                                     width="@LogoWidth" 
                                     height="@LogoHeight" 
                                     alt="@logo.AltText" 
                                     loading="lazy"
                                     draggable="false"
                                     class="osirion-logo-light">
                                <img src="@logo.DarkImageUrl" 
                                     width="@LogoWidth" 
                                     height="@LogoHeight" 
                                     alt="@logo.AltText" 
                                     loading="lazy"
                                     draggable="false"
                                     class="osirion-logo-dark">
                            }
                            else
                            {
                                <img src="@GetLogoUrl(logo)" 
                                     width="@LogoWidth" 
                                     height="@LogoHeight" 
                                     alt="@logo.AltText" 
                                     loading="lazy"
                                     draggable="false">
                            }
                        }
                    </li>
                }
                @if (ChildContent is not null)
                {
                    <li class="osirion-carousel-content-item" role="listitem">
                        @ChildContent
                    </li>
                }
            </ul>
            @if (EnableAutoScroll)
            {
                <ul class="osirion-carousel-list" aria-hidden="true">
                    @foreach (var logo in VisibleLogos)
                    {
                        <li class="@GetLogoClass(logo)">
                            @if (logo.HasDualLogos)
                            {
                                <img src="@logo.LightImageUrl" width="@LogoWidth" height="@LogoHeight" alt="" loading="lazy" draggable="false" class="osirion-logo-light">
                                <img src="@logo.DarkImageUrl" width="@LogoWidth" height="@LogoHeight" alt="" loading="lazy" draggable="false" class="osirion-logo-dark">
                            }
                            else
                            {
                                <img src="@GetLogoUrl(logo)" width="@LogoWidth" height="@LogoHeight" alt="" loading="lazy" draggable="false">
                            }
                        </li>
                    }
                    @if (ChildContent is not null)
                    {
                        <li class="osirion-carousel-content-item">@ChildContent</li>
                    }
                </ul>
            }
        </div>
        </div>
    </div>
</section>

<JS Src="./_content/Osirion.Blazor.Core/Components/Carousels/InfiniteLogoCarousel.razor.js" Args="@(new object[] { Refs })" />

